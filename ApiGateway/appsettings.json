{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "AuthServiceClients",
    "Key": "CHANGE_ME_IN_PRODUCTION_this_is_a_dev_key_with_enough_length_32b"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },

      "products-get-by-ids": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/by-ids",
          "Methods": [ "GET" ]
        }
      },
      "products-get-all": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products",
          "Methods": [ "GET" ]
        }
      },
      "products-create": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products",
          "Methods": [ "POST" ]
        }
      },
      "products-get-by-id": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/{id:guid}",
          "Methods": [ "GET" ]
        }
      },
      "products-update": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/{id:guid}",
          "Methods": [ "PUT" ]
        }
      },
      "products-delete": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/{id:guid}",
          "Methods": [ "DELETE" ]
        }
      },

      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },

      "orders-swagger": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/swagger-json/orders/swagger/v1/swagger.json"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger-json/orders" }
        ]
      },
      "products-swagger": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/swagger-json/products/swagger/v1/swagger.json"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger-json/products" }
        ]
      },
      "auth-swagger": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/swagger-json/auth/swagger/v1/swagger.json"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger-json/auth" }
        ]
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "d1": { "Address": "http://order-api:8080/" }
        }
      },
      "products-cluster": {
        "Destinations": {
          "d1": { "Address": "http://inventory-api:8080/" }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "d1": { "Address": "http://auth-api:8080/" }
        }
      }
    }
  }
}